# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL="gemini-2.5-flash"

# Required for production: stable signing secret and bcrypt hashes for enabled accounts.
JWT_SECRET=""
SIMRAS_ACCOUNT_PASSWORD_HASHES=""

# Standalone production: set to the mount path of a persistent disk, e.g. /var/data.
# Development defaults to data/runtime. This directory holds registrations.sqlite3.
SIMRAS_DATA_DIR=""

# Optional production persistence adapter. When set, officer asset registrations
# are sent server-to-server to FastAPI/PostgreSQL/PostGIS; the key never reaches
# the browser.
SIMRAS_BACKEND_URL=""
SIMRAS_BACKEND_ADMIN_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
